                txtContent += `钩子：${project.hook || '暂无'}\n\n`;
                
                // 角色信息
                txtContent += `【角色信息】\n`;
                
                if (project.characters.protagonist.length > 0) {
                    txtContent += `主角：\n`;
                    project.characters.protagonist.forEach((char, index) => {
                        txtContent += `  ${index + 1}. ${char.name} (${char.age}岁)\n`;
                        txtContent += `     身份：${char.identity}\n`;
                        txtContent += `     动机：${char.motivation}\n`;
                        txtContent += `     目标：${char.goal}\n`;
                        txtContent += `     心理：${char.psychology}\n`;
                    });
                }
                
                if (project.characters.antagonist.length > 0) {
                    txtContent += `反派：\n`;
                    project.characters.antagonist.forEach((char, index) => {
                        txtContent += `  ${index + 1}. ${char.name} (${char.age}岁)\n`;
                        txtContent += `     身份：${char.identity}\n`;
                        txtContent += `     动机：${char.motivation}\n`;
                        txtContent += `     目标：${char.goal}\n`;
                        txtContent += `     心理：${char.psychology}\n`;
                    });
                }
                
                if (project.characters.supporting.length > 0) {
                    txtContent += `配角：\n`;
                    project.characters.supporting.forEach((char, index) => {
                        txtContent += `  ${index + 1}. ${char.name} (${char.age}岁)\n`;
                        txtContent += `     身份：${char.identity}\n`;
                        txtContent += `     动机：${char.motivation}\n`;
                        txtContent += `     目标：${char.goal}\n`;
                        txtContent += `     心理：${char.psychology}\n`;
                    });
                }
                
                txtContent += '\n';
                
                // 结构信息
                txtContent += `【结构信息】\n`;
                txtContent += `开篇：${project.structure.opening || '暂无'}\n`;
                txtContent += `矛盾初现：${project.structure.conflictEmerge || '暂无'}\n`;
                txtContent += `矛盾爆发：${project.structure.conflictEscalate || '暂无'}\n`;
                txtContent += `矛盾转折：${project.structure.conflictTurn || '暂无'}\n`;
                txtContent += `矛盾解决：${project.structure.conflictResolve || '暂无'}\n`;
                
                if (project.structure.keyNodes.length > 0) {
                    txtContent += `关键节点：\n`;
                    project.structure.keyNodes.forEach((node, index) => {
                        txtContent += `  ${index + 1}. ${node.title}\n`;
                        txtContent += `     ${node.description}\n`;
                    });
                }
                
                txtContent += '\n';
                
                // 素材信息
                if (project.materials.length > 0) {
                    txtContent += `【素材信息】\n`;
                    project.materials.forEach((material, index) => {
                        txtContent += `  ${index + 1}. ${material.title}\n`;
                        txtContent += `     ${material.description}\n`;
                        if (material.source) {
                            txtContent += `     来源：${material.source}\n`;
                        }
                    });
                }
                
                txtContent += '\n';
                txtContent += `【时间信息】\n`;
                txtContent += `创建时间：${new Date(project.createdAt).toLocaleString()}\n`;
                txtContent += `更新时间：${new Date(project.updatedAt).toLocaleString()}\n`;
                
                return txtContent;
            }
            
            downloadFile(content, filename, mimeType) {
                const blob = new Blob([content], { type: mimeType });
                const link = document.createElement('a');
                const url = URL.createObjectURL(blob);
                
                link.setAttribute('href', url);
                link.setAttribute('download', filename);
                link.style.display = 'none';
                
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                
                setTimeout(() => URL.revokeObjectURL(url), 100);
            }
            
            clearForm() {
                document.getElementById('project-form').reset();
                
                // 清空角色、节点、素材
                document.getElementById('protagonist-container').innerHTML = '';
                document.getElementById('antagonist-container').innerHTML = '';
                document.getElementById('supporting-container').innerHTML = '';
                document.getElementById('key-nodes-container').innerHTML = '';
                document.getElementById('materials-container').innerHTML = '';
                
                // 重置计数
                characterCounts = { protagonist: 0, antagonist: 0, supporting: 0 };
                keyNodeCount = 0;
                materialCount = 0;
            }
            
            saveToStorage() {
                localStorage.setItem('cyberpunk_projects', JSON.stringify(this.projects));
            }
            
            showNotification(message, type = 'info') {
                const notification = document.getElementById('notification');
                const icon = document.getElementById('notification-icon');
                const messageEl = document.getElementById('notification-message');
                
                if (type === 'success') {
                    icon.className = 'fa fa-check-circle text-green-400 text-xl';
                    notification.className = notification.className.replace(/border-\w+/, 'border-green-400');
                } else if (type === 'error') {
                    icon.className = 'fa fa-exclamation-circle text-red-400 text-xl';
                    notification.className = notification.className.replace(/border-\w+/, 'border-red-400');
                } else {
                    icon.className = 'fa fa-info-circle text-cyan text-xl';
                    notification.className = notification.className.replace(/border-\w+/, 'border-cyan');
                }
                
                messageEl.textContent = message;
                
                notification.classList.remove('translate-x-full');
                
                setTimeout(() => {
                    notification.classList.add('translate-x-full');
                }, 3000);
            }
        }

        // 全局函数
        function addCharacter(type) {
            if (characterCounts[type] >= 10) {
                projectManager.showNotification(`最多只能添加10个${type === 'protagonist' ? '主角' : type === 'antagonist' ? '反派' : '配角'}`, 'error');
                return;
            }
            
            const container = document.getElementById(`${type}-container`);
            const card = document.createElement('div');
            card.className = 'character-card animate-fade-in';
            
            const typeNames = {
                protagonist: '主角',
                antagonist: '反派',
                supporting: '配角'
            };
            
            card.innerHTML = `
                <div class="flex justify-between items-center mb-2">
                    <h5 class="font-semibold text-${type === 'protagonist' ? 'secondary' : type === 'antagonist' ? 'highlight' : 'accent'}">${typeNames[type]} ${++characterCounts[type]}</h5>
                    <button type="button" onclick="removeCharacter('${type}', this)" class="text-gray-400 hover:text-highlight">
                        <i class="fa fa-times"></i>
                    </button>
                </div>
                <div class="space-y-2 text-sm">
                    <input type="text" class="${type}-name input-cyber w-full p-2 rounded" placeholder="角色姓名">
                    <input type="text" class="${type}-age input-cyber w-full p-2 rounded" placeholder="角色年龄">
                    <input type="text" class="${type}-identity input-cyber w-full p-2 rounded" placeholder="社会身份">
                    <input type="text" class="${type}-motivation input-cyber w-full p-2 rounded" placeholder="行为动机">
                    <input type="text" class="${type}-goal input-cyber w-full p-2 rounded" placeholder="角色目的">
                    <textarea class="${type}-psychology input-cyber w-full p-2 rounded" rows="2" placeholder="心理挖掘"></textarea>
                </div>
            `;
            
            container.appendChild(card);
        }

        function removeCharacter(type, button) {
            const card = button.closest('.character-card');
            card.remove();
            characterCounts[type]--;
            
            // 重新编号
            const cards = document.querySelectorAll(`#${type}-container .character-card`);
            cards.forEach((card, index) => {
                card.querySelector('h5').textContent = `${type === 'protagonist' ? '主角' : type === 'antagonist' ? '反派' : '配角'} ${index + 1}`;
            });
        }

        function addKeyNode() {
            if (keyNodeCount >= 20) {
                projectManager.showNotification('最多只能添加20个关键节点', 'error');
                return;
            }
            
            const container = document.getElementById('key-nodes-container');
            const card = document.createElement('div');
            card.className = 'node-card animate-fade-in';
            
            card.innerHTML = `
                <div class="flex justify-between items-center mb-2">
                    <h5 class="font-semibold text-accent">关键节点 ${++keyNodeCount}</h5>
                    <button type="button" onclick="removeKeyNode(this)" class="text-gray-400 hover:text-highlight">
                        <i class="fa fa-times"></i>
                    </button>
                </div>
                <div class="space-y-2 text-sm">
                    <input type="text" class="node-title input-cyber w-full p-2 rounded" placeholder="节点标题">
                    <textarea class="node-description input-cyber w-full p-2 rounded" rows="2" placeholder="节点描述"></textarea>
                </div>
            `;
            
            container.appendChild(card);
        }

        function removeKeyNode(button) {
            const card = button.closest('.node-card');
            card.remove();
            keyNodeCount--;
            
            // 重新编号
            const cards = document.querySelectorAll('#key-nodes-container .node-card');
            cards.forEach((card, index) => {
                card.querySelector('h5').textContent = `关键节点 ${index + 1}`;
            });
        }

        function addMaterial() {
            if (materialCount >= 20) {
                projectManager.showNotification('最多只能添加20个素材', 'error');
                return;
            }
            
            const container = document.getElementById('materials-container');
            const card = document.createElement('div');
            card.className = 'material-card animate-fade-in';
            
            card.innerHTML = `
                <div class="flex justify-between items-center mb-2">
                    <h5 class="font-semibold text-highlight">素材 ${++materialCount}</h5>
                    <button type="button" onclick="removeMaterial(this)" class="text-gray-400 hover:text-highlight">
                        <i class="fa fa-times"></i>
                    </button>
                </div>
                <div class="space-y-2 text-sm">
                    <input type="text" class="material-title input-cyber w-full p-2 rounded" placeholder="素材标题">
                    <textarea class="material-description input-cyber w-full p-2 rounded" rows="2" placeholder="素材描述"></textarea>
                    <input type="text" class="material-source input-cyber w-full p-2 rounded" placeholder="素材来源">
                </div>
            `;
            
            container.appendChild(card);
        }

        function removeMaterial(button) {
            const card = button.closest('.material-card');
            card.remove();
            materialCount--;
            
            // 重新编号
            const cards = document.querySelectorAll('#materials-container .material-card');
            cards.forEach((card, index) => {
                card.querySelector('h5').textContent = `素材 ${index + 1}`;
            });
        }

        function closeModal() {
            document.getElementById('project-modal').classList.add('hidden');
            currentProjectId = null;
        }

        // 清空表单函数
        function clearForm() {
            if (confirm('确定要清空当前填写的内容吗？此操作不可恢复。')) {
                document.getElementById('project-form').reset();
                
                // 清空角色、节点、素材
                document.getElementById('protagonist-container').innerHTML = '';
                document.getElementById('antagonist-container').innerHTML = '';
                document.getElementById('supporting-container').innerHTML = '';
                document.getElementById('key-nodes-container').innerHTML = '';
                document.getElementById('materials-container').innerHTML = '';
                
