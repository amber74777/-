            deleteProject(id) {
                if (confirm('确定要删除这个项目吗？此操作不可恢复。')) {
                    this.projects = this.projects.filter(p => p.id !== id);
                    this.saveToStorage();
                    this.loadProjects();
                    this.showNotification('项目删除成功！', 'success');
                }
            }
            
            exportAllProjects() {
                if (this.projects.length === 0) {
                    this.showNotification('暂无项目可导出', 'error');
                    return;
                }
                
                const format = document.getElementById('export-format').value;
                let content, filename, mimeType;
                
                if (format === 'csv') {
                    content = this.convertToCSV(this.projects);
                    filename = 'all_projects.csv';
                    mimeType = 'text/csv;charset=utf-8;';
                } else if (format === 'txt') {
                    content = this.convertToTXT(this.projects);
                    filename = 'all_projects.txt';
                    mimeType = 'text/plain;charset=utf-8;';
                } else if (format === 'json') {
                    content = JSON.stringify(this.projects, null, 2);
                    filename = 'all_projects.json';
                    mimeType = 'application/json;charset=utf-8;';
                }
                
                this.downloadFile(content, filename, mimeType);
                this.showNotification('项目导出成功！', 'success');
            }
            
            exportSingleProject(id, format) {
                const project = this.projects.find(p => p.id === id);
                if (!project) return;
                
                let content, filename, mimeType;
                
                if (format === 'csv') {
                    content = this.convertToCSV([project]);
                    filename = `${project.name}_project.csv`;
                    mimeType = 'text/csv;charset=utf-8;';
                } else if (format === 'txt') {
                    content = this.convertToDetailedTXT(project);
                    filename = `${project.name}_project.txt`;
                    mimeType = 'text/plain;charset=utf-8;';
                } else if (format === 'json') {
                    content = JSON.stringify(project, null, 2);
                    filename = `${project.name}_project.json`;
                    mimeType = 'application/json;charset=utf-8;';
                }
                
                this.downloadFile(content, filename, mimeType);
                this.showNotification('项目导出成功！', 'success');
            }
            
            convertToCSV(projects) {
                const headers = ['项目名称', '类型', '分类', '一句话故事', '期待感', '钩子', '主角数量', '反派数量', '配角数量', '关键节点数量', '素材数量', '创建时间', '更新时间'];
                const csvContent = [headers.join(',')];
                
                projects.forEach(project => {
                    const row = [
                        `"${project.name}"`,
                        `"${project.type}"`,
                        `"${project.category}"`,
                        `"${project.oneLine || ''}"`,
                        `"${project.expectation || ''}"`,
                        `"${project.hook || ''}"`,
                        project.characters.protagonist.length,
                        project.characters.antagonist.length,
                        project.characters.supporting.length,
                        project.structure.keyNodes.length,
                        project.materials.length,
                        `"${new Date(project.createdAt).toLocaleString()}"`,
                        `"${new Date(project.updatedAt).toLocaleString()}"`
                    ];
                    csvContent.push(row.join(','));
                });
                
                return csvContent.join('\n');
            }
            
            convertToTXT(projects) {
                let txtContent = `===== 项目列表 =====\n\n`;
                
                projects.forEach((project, index) => {
                    txtContent += `【项目 ${index + 1}】${project.name}\n`;
                    txtContent += `类型：${project.type} | 分类：${project.category}\n`;
                    txtContent += `一句话故事：${project.oneLine || '暂无'}\n`;
                    txtContent += `角色：主角${project.characters.protagonist.length}人 | 反派${project.characters.antagonist.length}人 | 配角${project.characters.supporting.length}人\n`;
                    txtContent += `节点：${project.structure.keyNodes.length}个 | 素材：${project.materials.length}个\n`;
                    txtContent += `更新时间：${new Date(project.updatedAt).toLocaleString()}\n`;
                    txtContent += '=' .repeat(50) + '\n\n';
                });
                
                return txtContent;
            }
            
            convertToDetailedTXT(project) {
                let txtContent = `===== ${project.name} =====\n\n`;
                
                // 基础信息
                txtContent += `【基础信息】\n`;
                txtContent += `项目名称：${project.name}\n`;
