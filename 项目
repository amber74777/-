                        <input type="text" class="material-title input-cyber w-full p-2 rounded" placeholder="素材标题" value="${material.title}">
                        <textarea class="material-description input-cyber w-full p-2 rounded" rows="2" placeholder="素材描述">${material.description}</textarea>
                        <input type="text" class="material-source input-cyber w-full p-2 rounded" placeholder="素材来源" value="${material.source}">
