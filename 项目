            editProject(id) {
                const project = this.projects.find(p => p.id === id);
                if (!project) return;
                
                currentProjectId = id;
                
                // 填充基础信息
                document.getElementById('project-name').value = project.name;
                document.getElementById('project-ip-source').value = project.ipSource || '';
                document.getElementById('project-type').value = project.type;
                document.querySelector(`input[name="project-category"][value="${project.category}"]`).checked = true;
                document.querySelector(`input[name="project-purpose"][value="${project.purpose}"]`).checked = true;
                document.getElementById('project-one-line').value = project.oneLine || '';
                document.getElementById('project-expectation').value = project.expectation || '';
                document.getElementById('project-hook').value = project.hook || '';
                
                // 填充结构信息
                document.getElementById('structure-opening').value = project.structure.opening || '';
                document.getElementById('structure-conflict-emerge').value = project.structure.conflictEmerge || '';
                document.getElementById('structure-conflict-escalate').value = project.structure.conflictEscalate || '';
                document.getElementById('structure-conflict-turn').value = project.structure.conflictTurn || '';
                document.getElementById('structure-conflict-resolve').value = project.structure.conflictResolve || '';
                
                // 清空现有角色、节点、素材
                document.getElementById('protagonist-container').innerHTML = '';
                document.getElementById('antagonist-container').innerHTML = '';
                document.getElementById('supporting-container').innerHTML = '';
                document.getElementById('key-nodes-container').innerHTML = '';
                document.getElementById('materials-container').innerHTML = '';
                
                // 重置计数
                characterCounts = { protagonist: 0, antagonist: 0, supporting: 0 };
                keyNodeCount = 0;
                materialCount = 0;
                
                // 填充角色信息
                project.characters.protagonist.forEach(char => this.restoreCharacter('protagonist', char));
                project.characters.antagonist.forEach(char => this.restoreCharacter('antagonist', char));
                project.characters.supporting.forEach(char => this.restoreCharacter('supporting', char));
                
                // 填充关键节点
                project.structure.keyNodes.forEach(node => this.restoreKeyNode(node));
                
                // 填充素材
                project.materials.forEach(material => this.restoreMaterial(material));
                
                // 滚动到顶部
                window.scrollTo({ top: 0, behavior: 'smooth' });
                
                this.showNotification('项目数据已加载到表单，修改后请重新保存', 'info');
            }
            
            restoreCharacter(type, char) {
                const container = document.getElementById(`${type}-container`);
                const card = document.createElement('div');
                card.className = 'character-card animate-fade-in';
                
                const typeNames = {
                    protagonist: '主角',
                    antagonist: '反派',
                    supporting: '配角'
                };
                
                card.innerHTML = `
                    <div class="flex justify-between items-center mb-2">
                        <h5 class="font-semibold text-${type === 'protagonist' ? 'secondary' : type === 'antagonist' ? 'highlight' : 'accent'}">${typeNames[type]} ${++characterCounts[type]}</h5>
