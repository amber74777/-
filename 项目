                characterCounts = { protagonist: 0, antagonist: 0, supporting: 0 };
                keyNodeCount = 0;
                materialCount = 0;
                
                // 重置当前项目ID
                currentProjectId = null;
                
                projectManager.showNotification('表单内容已清空', 'info');
