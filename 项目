                        <input type="text" class="${type}-goal input-cyber w-full p-2 rounded" placeholder="角色目的" value="${char.goal}">
                        <textarea class="${type}-psychology input-cyber w-full p-2 rounded" rows="2" placeholder="心理挖掘">${char.psychology}</textarea>
                    </div>
                `;
                
                container.appendChild(card);
            }
            
            restoreKeyNode(node) {
                const container = document.getElementById('key-nodes-container');
                const card = document.createElement('div');
                card.className = 'node-card animate-fade-in';
                
                card.innerHTML = `
                    <div class="flex justify-between items-center mb-2">
